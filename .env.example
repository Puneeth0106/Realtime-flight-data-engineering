# Copy to .env and replace the placeholders. Never commit the real .env file.
# docker compose reads this file automatically.

# ---------- POSTGRES (Airflow metadata database) ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

# ---------- AIRFLOW ADMIN USER ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=change_me

# ---------- SNOWFLAKE ----------
# Not read by docker-compose.yml. The DAG reads Snowflake credentials from the
# Airflow connection "flight_snowflake" (see README). These values are the ones
# you enter in that connection; they are listed here only as a reminder.
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_ACCOUNT=your_account_identifier
# SNOWFLAKE_WAREHOUSE=your_warehouse
# SNOWFLAKE_ROLE=your_role
